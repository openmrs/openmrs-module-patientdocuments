             visit_id="605" encounter_datetime="2025-06-05 09:00:00.0"
             creator="1" date_created="2025-06-05 00:00:00.0" voided="false"
             uuid="00000607-enc7-enc7-enc7-000000000607"/>
  <encounter_provider encounter_provider_id="103" encounter_id="607" provider_id="100"
