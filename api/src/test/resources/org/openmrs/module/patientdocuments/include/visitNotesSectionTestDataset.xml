       location_id="1" creator="1" date_created="2025-06-05 00:00:00.0"
       voided="false" uuid="0obs2008-0000-0000-0000-000000020008" status="FINAL"/>

  <!-- Note whose encounter has two clinician-role providers -->
  <encounter encounter_id="608" encounter_type="1" patient_id="2" location_id="1"
             visit_id="605" encounter_datetime="2025-06-05 10:00:00.0"
             creator="1" date_created="2025-06-05 00:00:00.0" voided="false"
             uuid="00000608-enc8-enc8-enc8-000000000608"/>
  <encounter_provider encounter_provider_id="104" encounter_id="608" provider_id="100"
             encounter_role_id="100" creator="1" date_created="2025-06-05 00:00:00.0"
             voided="false" uuid="0000ep05-0000-0000-0000-000000000104"/>
  <encounter_provider encounter_provider_id="105" encounter_id="608" provider_id="101"
             encounter_role_id="100" creator="1" date_created="2025-06-05 00:00:00.0"
             voided="false" uuid="0000ep06-0000-0000-0000-000000000105"/>
  <obs obs_id="20009" person_id="2" concept_id="6001" encounter_id="608"
       obs_datetime="2025-06-05 10:00:00.0" value_text="Jointly written team note"
       location_id="1" creator="1" date_created="2025-06-05 00:00:00.0"
       voided="false" uuid="0obs2009-0000-0000-0000-000000020009" status="FINAL"/>

  <!-- ── Visit 606: one provider-less encounter carrying three notes ─────── -->
  <!-- Provider attribution is a property of the encounter, so all three notes must
       resolve it once between them rather than once each. -->

  <visit visit_id="606" patient_id="2" visit_type_id="1"
